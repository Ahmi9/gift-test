{%- render 'gt-fonts', sans: section.settings.font_sans, serif: section.settings.font_serif -%}
{{ 'gt-banner.css' | asset_url | stylesheet_tag }}

<div class="gt-banner">
    <a href="{{ routes.root_url }}" class="gt-banner-logo">{{ section.settings.logo_text | escape }}</a>
  
    {%- if section.settings.tagline != blank -%}
      <p class="gt-banner-slogan">{{ section.settings.tagline | escape }}</p>
    {%- endif -%}
  
    {%- if section.settings.button_link != blank -%}
      <a class="gt-banner-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        <span>{{ section.settings.button_label | escape }}</span>
        {%- render 'gt-icon-arrow' -%}
      </a>
    {%- endif -%}  
  
</div>

{% schema %}
{
  "name": "Gift Guide banner",
  "settings": [
    {
      "type": "font_picker",
      "id": "font_sans",
      "label": "Sans Font",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "font_serif",
      "label": "Serif Font",
      "default": "lora_n4"
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose Gift"
    }
  ],
  "presets": [{ "name": "Gift Guide banner" }]
}
{% endschema %}
