{%- render 'gt-fonts', sans: section.settings.font_sans, serif: section.settings.font_serif -%}

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  .gt-banner{
    font-family: var(--gt-font-sans);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #313131;
    padding: 30px 50px;
  }

  .gt-banner-logo {
    border: 2px solid red;
    padding: 0;
  }

  .gt-banner-slogan {
    border: 2px solid red;
  }

  h1 {
    border: 2px solid white;
    margin: 0;
  }

  p {
    border: 2px solid white;
    margin: 0;
  }


</style>




<div class="gt-banner">
  <div class="gt-banner-logo">
    <h1>TISSO VISON</h1>
  </div>
  <div class="gt-banner-slogan">
    <p>Find the ideal gift for your loved ones.</p>
  </div>
  <div class="gt-banner-btn">
    <button>Choose Gift<span class="btn-arrow"></span></button>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide banner",
  "settings": [
    {
      "type": "font_picker",
      "id": "font_sans",
      "label": "Sans Font",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "font_serif",
      "label": "Serif Font",
      "default": "lora_n4"
    }
  ],
  "presets": [{ "name": "Gift Guide banner" }]
}
{% endschema %}