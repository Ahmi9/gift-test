{%- render 'gt-fonts', sans: section.settings.font_sans, serif: section.settings.font_serif -%}

<style>
  .gt-banner{
    font-family: var(--gt-font-sans);
  }
</style>




<div class="gt-banner">
  <div class="gt-banner-logo">
    <h1>TISSO VISON</h1>
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide banner",
  "settings": [
    {
      "type": "font_picker",
      "id": "font_sans",
      "label": "Sans Font",
      "default": "jost_n4"
    },
    {
      "type": "font_picker",
      "id": "font_serif",
      "label": "Serif Font",
      "default": "lora_n4"
    }
  ],
  "presets": [{ "name": "Gift Guide banner" }]
}
{% endschema %}